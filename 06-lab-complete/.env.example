# ============================================================
# Biến môi trường của agent — KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  rồi sửa .env (file .env đã nằm trong .gitignore)
# Trên Railway / Render: đặt các biến này trong dashboard, không dùng file .env.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — secret: thay bằng chuỗi ngẫu nhiên dài, vd: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=replace-with-a-long-random-string

# Redis (rate limit + cost guard). Trong docker compose giá trị này bị ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
