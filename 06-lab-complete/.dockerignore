# Những gì KHÔNG đưa vào Docker build context / image
# (Docker so khớp theo đường dẫn từ gốc context → dùng **/ cho thư mục lồng nhau)

# Secrets — giữ lại .env.example
.env
.env.*
!.env.example

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo
.pytest_cache/

# Virtualenv
venv/
.venv/

# Git, IDE, tài liệu
.git/
.gitignore
.vscode/
.idea/
*.md

# Không cần trong image chạy production
benchmark-observability/
check_production_ready.py
docker-compose.yml
railway.toml
render.yaml
